flowchart TB
    subgraph Client["Frontend (React + Vite)"]
        UI[PostInTime UI]
        Router[React Router]
        Query[TanStack Query]
        PostsPager[Channel posts pager]
        BulkUI[Multiselect across pages + bulk post modal<br/>interval slider 5-30 min, queue panel]
        UI --> Router
        UI --> Query
        UI --> PostsPager
        UI --> BulkUI
        PostsPager --> Query
        BulkUI --> Query
    end

    subgraph API["Backend (Spring Boot)"]
        Auth[Auth Module]
        ApiTokens[API Token Module]
        Channels[Channel Module]
        Posts[Post Module]
        Media[Media Module]
        MediaThumbs[Thumbnails ?size=]
        Social[Social Account Module]
        Publishing[Publishing Module]
        BulkPublish[Bulk Publish Jobs API<br/>appends to per-channel queue]
        BulkScheduler[Bulk Publish Scheduler<br/>earliest due queued post, sequential]
        Public[Public API]
        Swagger[Swagger UI]
        Auth --> Channels
        Auth --> ApiTokens
        ApiTokens --> Public
        Public --> Channels
        Public --> Posts
        Public --> Media
        Swagger -.-> Public
        Channels --> Posts
        Channels --> Social
        Posts --> Publishing
        Social --> Publishing
        BulkPublish -.->|queued posts locked| Publishing
        Channels --> BulkPublish
        BulkPublish --> BulkScheduler
        BulkScheduler --> Publishing
        Media --> Posts
        Media --> MediaThumbs
    end

    subgraph Data["Data Layer"]
        PG[(PostgreSQL)]
        Storage[(Object Storage / MinIO)]
    end

    Query -->|REST /api/v1| Auth
    ApiTokens --> PG
    Channels --> PG
    Posts --> PG
    Social --> PG
    Publishing --> PG
    BulkPublish --> PG
    BulkScheduler --> PG
    Media --> Storage
    Media --> PG

    subgraph Packaging["Packaging"]
        Compose[Docker Compose]
        BeImage[Backend Docker image]
        FeImage[Frontend Docker image]
        Compose --> BeImage
        Compose --> FeImage
        Compose --> PG
        Compose --> Storage
    end
    API --> BeImage
    Client --> FeImage

    subgraph Future["Publishing adapters"]
        Manual[ManualSocialMediaPublisher]
        Webhook[WebhookSocialMediaPublisher]
        LinkedIn[LinkedInPublisher]
        Instagram[InstagramPublisher]
        Publishing --> Manual
        Publishing --> Webhook
        Publishing -.-> LinkedIn
        Publishing -.-> Instagram
    end
