# Spring Boot
SPRING_PROFILES_ACTIVE=local

# Database (localhost when the backend runs on the host; Compose overrides to postgres:5432)
DATABASE_URL=jdbc:postgresql://localhost:5432/postintime
DATABASE_USERNAME=app
DATABASE_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Storage (MinIO for local dev; Compose overrides STORAGE_ENDPOINT to http://minio:9000)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=postintime
STORAGE_REGION=us-east-1

# App
APP_BASE_URL=http://localhost:8080
# Optional listen port (Cloud Run sets PORT automatically)
# PORT=8080
# Documented browser origin. The API also allows other Origins (Postman, curl) because auth is Bearer, not cookies.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (baked into the UI image at docker build time)
VITE_API_BASE_URL=http://localhost:8080
