# Spring Boot
SPRING_PROFILES_ACTIVE=local

# Database (localhost when the backend runs on the host; Compose overrides to postgres:5432)
DATABASE_URL=jdbc:postgresql://localhost:5432/postintime
DATABASE_USERNAME=app
DATABASE_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Docker Compose host ports (containers keep internal 8080 / 80 / 9000 / 9001)
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Storage (MinIO for local dev; Compose overrides STORAGE_ENDPOINT to http://minio:9000)
# When the backend runs on the host, this must match MINIO_API_HOST_PORT.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=postintime
STORAGE_REGION=us-east-1

# App
# Optional listen port inside the container / process (Cloud Run sets PORT automatically)
# PORT=8080
# Public URL browsers use to reach the API (media links from POST /api/v1/media use this).
# Compose defaults it from BACKEND_HOST_PORT when unset. No trailing slash.
APPLICATION_ROOT_URL=http://localhost:8080
# CORS origin for the UI. Compose defaults from FRONTEND_HOST_PORT when unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Frontend API base (must match APPLICATION_ROOT_URL for browser calls). Baked in at UI image build.
VITE_API_BASE_URL=http://localhost:8080
