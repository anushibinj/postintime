# Copy to .env and fill in. `pnpm start` loads .env automatically.

# The channel to post to goes in the webhook URL: /webhooks/post-to-channel/<channel id>.
# Optional default channel for calls to /webhooks/post-to-channel without an id. Set at most ONE of these:
# - the channel id, printed at startup under "Channels on this WhatsApp account"
WHATSAPP_CHANNEL_ID=
# - or the invite code / link from the channel's "Share" option, e.g. https://whatsapp.com/channel/0029Va...
WHATSAPP_CHANNEL_INVITE_CODE=

# HTTP port for the webhook server.
PORT=3000
HOST=0.0.0.0

# Optional HTTP Basic auth. Use the same username/password on the postintime social account.
WEBHOOK_USERNAME=
WEBHOOK_PASSWORD=

# Where the WhatsApp login is saved (so the QR code is only needed once).
WHATSAPP_SESSION_DIR=.wwebjs_auth

# Seconds to wait for chats to load after the login is accepted before giving up (and exiting).
WHATSAPP_READY_TIMEOUT_SECONDS=300

# Set to false to see the Chrome window.
HEADLESS=true

# Use an installed Chrome/Chromium instead of the one Puppeteer downloads.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
